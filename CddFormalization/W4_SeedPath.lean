import Mathlib.Data.Real.Basic
import Mathlib.Tactic.NormNum
import CddFormalization.W3_DoseLandscape

/-! # W4 Seed Path: S14 种子逐步替换连续性检验

    wave_proto S14 (实现族敏感性机理, 蒸馏文档 §8(vii)) 的 recorded-stats
    登记与预注册 P1/P2/P3 裁决断言。

    ## 数据与算术约定 (s14_export.json 导出管线, ×480 整数性检验全通过)

    - 主指标 ema_phase3 = mean(EMA@{15,30,50}) = K/480, **K 为精确整数**;
      K = K15 + K30 + K50 (每检查点 EMA 评估 = Kᵢ/160);
    - 所有登记值零舍入: Lean 端只登记 K, 不重算 (s14seed_*.npz 为唯一
      数据源, 与 W3 登记模式一致)。

    ## S14 实验内容 (s14_seed_path.py, 2026-08-31)

    S13 证明剂量地形是"介质 × 实现族"联合属性 (噪声池整体替换 → 双峰
    翻转)。S14 沿单自由度路径分解整体替换, 区分两种机理:
      (a) H-a 累积形变: 每个噪声实现贡献微小扰动, 逐步放大 → 路径连续
      (b) H-b 多稳态选择: 单个种子身份即重选吸引盆 → 路径出现临界步
    替换路径 (每步恰好换一个训练噪声种子, fixO 其余不动):
      L0 = {0,1,2}   原协议 (S12 数据, W3 登记)
      L1 = {0,1,10}  替换 1 个种子 (seed 2 → 10)
      L2 = {0,10,11} 替换 2 个种子 (seed 1→10, 2→11)
      L3 = {10,11,12} 全替换 = S13 族 N (W3 登记)
    剂量: {0.35, 0.40, 0.45, 0.50} × {L1, L2} = 8 新臂 + L1 r0.50 双跑;
    探索性对照 (预注册外): c = {0,1,3} @ r=0.50 (换任意单种子)。

    ## 预注册判读规则 (执行前固定)

    可解读阈值: R = |K(L3)−K(L0)| ≥ 12 (0.40 的 R=2 为跨族不敏感点)。
    逐剂量: 连续 = 最大单步 ≤ R/2 ∧ 路径长 ≤ 2R;
            临界步 = 最大单步 > R/2; 重组 = 路径长 > 2R。
    纹理: 峰签名 S(L) = (K_035>K_040, K_050>K_045); 一步双翻转 = 突变。

    ## 本模块证明的定理

    §1 recorded-stats: L1/L2 8 点 + 探索性 c 对照 (K 整数) + 检查点和
    §2 E1 `s14_e1_bit`           : L1 r0.50 双跑 BIT 一致
    §3 判读域: R 值 + 0.40 不敏感
    §4 P2 临界步 (三个可解读剂量全部触发):
       `s14_p2_d050_first`        : r=0.50 临界步在**第一步** (2·53>51,
                                    单步位移超过净位移 R 本身)
       `s14_p2_d045_last`         : r=0.45 临界步在**最后一步** (2·22>27)
       `s14_p2_d035`              : r=0.35 前两步均临界 (2·19, 2·20 > 32)
       `s14_dose_dependent`       : 临界步位置随剂量移动 —— 不存在
                                    "那个临界种子", 每个剂量各有敏感种子
    §5 P1 否定 + P3 否定:
       `s14_p1_rejected`          : 任何可解读剂量都不连续
       `s14_p3_nowhere`           : 任何剂量都未达重组阈值 (路径长 ≤ 2R)
       `s14_d050_nonmonotone`     : r=0.50 路径非单调 (L2=49 反弹高于
                                    L1=36 与 L3=38) —— 反对累积形变
    §6 纹理突变: `s14_texture_abrupt` —— L1→L2 一步同时翻转两个峰签名
    §7 探索性对照: `s14_control_any_seed` —— 换任意单种子 ({0,1,3} 或
       {0,1,10}) 峰② 均崩塌 (34/36 < L3 全替换的 38) —— 崩塌非种子值
       特异, 是"单种子身份"的普遍效应
    §8 总裁决 `s14_verdict_summary` : P2 临界单种子 → 多稳态选择 (H-b)
    §9 溯源哈希: 全部 7 个 S14 数据文件 SHA256 登记

    ## 科学结论 (S14 裁决)

    H-a 累积形变被否定: 路径无任何剂量点连续, 且非单调。H-b 多稳态
    选择成立, 但有一个重要细化: **不存在单一的"临界种子"** —— r=0.50
    的崩塌由第一个替换触发, r=0.45 的崩塌由最后一个替换触发, 即每个
    剂量点对不同的种子身份敏感。峰② 针尖 (K=89) 由噪声实现 {0,1,2}
    的具体身份支撑: 换任意一个种子即崩塌至 34-36 (低于全替换的 38);
    而 r=0.40 谷点跨族不动 (R=2) —— **峰脆弱、谷稳健**。CDD 理论
    对齐: sc 涨落的具体实现 (非统计性质) 参与选择 ac 层几何的吸引盆,
    三像联合响应面在最细粒度 (单种子) 上即不可分离。

    ## 诚实声明 (形式化范围边界)

    - 登记的是 recorded K 值 (npz 数据源), 非在 Lean 内重跑实验;
    - 探索性对照 c 为预注册外事后追加 (用于区分种子值特异 vs 普遍
      效应), 在本模块中明确标注, 不参与预注册 P1/P2/P3 判读;
    - 全部断言为精确整数/有理数算术, 无浮点。

    CDD Framework v28.4 · wave_proto S14 种子路径
    Date: 2026-08-31
    Toolchain: Lean v4.32.2 + Mathlib (mathlib432 local checkout)
-/

namespace CDD.W4.SeedPath

open CDD.W3.DoseLandscape (s12K035 s12K040 s12K045 s12K050
  s13nK035 s13nK040 s13nK045 s13nK050)

-- ============================================================
-- §1 recorded-stats: K = ema_phase3 × 480 (精确整数, 零舍入登记)
-- ============================================================

/- S14 替换路径 K 表 (s14seed_p1-p6.npz, ema_phase3):
     dose:     0.35    0.40    0.45    0.50
     L0 (S12):  66      40      47      89     ← W3 已登记 (s12K*)
     L1 {0,1,10}: 47    45      49      36
     L2 {0,10,11}: 27   39      42      49
     L3 (S13N):  34      42      20      38     ← W3 已登记 (s13nK*) -/

abbrev s14aK035 : ℤ := 47    -- L1 = {0,1,10}
abbrev s14aK040 : ℤ := 45
abbrev s14aK045 : ℤ := 49
abbrev s14aK050 : ℤ := 36
abbrev s14bK035 : ℤ := 27    -- L2 = {0,10,11}
abbrev s14bK040 : ℤ := 39
abbrev s14bK045 : ℤ := 42
abbrev s14bK050 : ℤ := 49
abbrev s14cK050 : ℤ := 34    -- 探索性对照 c = {0,1,3} @ r=0.50

/- 检查点级 K160 = EMA 评估 × 160 (s14_export.json §checkpoint_K160):
     K = K15 + K30 + K50, 逐臂核验 (BIT 复跑臂 a050r 与 a050 逐点一致)。 -/

theorem s14_a035_sum : 11 + 3 + 33 = s14aK035 := by decide
theorem s14_a040_sum : 38 + 2 + 5 = s14aK040 := by decide
theorem s14_a045_sum : 12 + 23 + 14 = s14aK045 := by decide
theorem s14_a050_sum : 17 + 15 + 4 = s14aK050 := by decide
theorem s14_b035_sum : 14 + 11 + 2 = s14bK035 := by decide
theorem s14_b040_sum : 18 + 10 + 11 = s14bK040 := by decide
theorem s14_b045_sum : 8 + 23 + 11 = s14bK045 := by decide
theorem s14_b050_sum : 9 + 26 + 14 = s14bK050 := by decide

-- ============================================================
-- §2 E1 替换协议 BIT 确定性
-- ============================================================

def a050cps : List ℤ := [17, 15, 4]    -- s14seed_p2.npz a050 EMA@{15,30,50}
def a050rcps : List ℤ := [17, 15, 4]   -- s14seed_p5.npz a050r (BIT 复跑)

/-- **E1**: L1 r0.50 双跑三检查点 K160 逐点完全一致 —— 替换协议仍是
    确定性协议, S14 全部数值可复现, 非随机涨落。 -/
theorem s14_e1_bit : a050cps = a050rcps := by rfl

/-- 检查点级复原: a050 的 phase3 K = 三检查点 K160 之和。 -/
theorem s14_e1_phase3_sum : 17 + 15 + 4 = s14aK050 := by decide

-- ============================================================
-- §3 判读域: R = |K(L3) − K(L0)| 与可解读阈值
-- ============================================================

/-- 四个剂量点的净位移 R: 0.35→32, 0.40→2, 0.45→27, 0.50→51。 -/
theorem s14_R_values :
    s12K035 - s13nK035 = 32 ∧ s13nK040 - s12K040 = 2 ∧
      s12K045 - s13nK045 = 27 ∧ s12K050 - s13nK050 = 51 := by decide

/-- **判读域**: 0.35/0.45/0.50 可解读 (R ≥ 12), 0.40 为跨族不敏感点
    (R = 2 < 12) —— 谷点在两实现族间几乎不动, 本身即结论。 -/
theorem s14_dose_interpretable :
    (32 : ℤ) ≥ 12 ∧ (2 : ℤ) < 12 ∧ (27 : ℤ) ≥ 12 ∧ (51 : ℤ) ≥ 12 := by decide

-- ============================================================
-- §4 P2 临界步 (预注册: 最大单步 |ΔK| > R/2 ⇔ 2·|ΔK| > R)
-- ============================================================

/-! ### r=0.50: 临界步在第一步, 且单步位移超过净位移本身

    路径 89 → 36 → 49 → 38, 步长 53/13/11, R = 51:
    第一个单种子替换 (seed 2→10, 池的 1/3) 即造成 53 > 51 —— 峰②
    一步崩塌到低于全替换水平。 -/

theorem s14_p2_d050_first :
    2 * (s12K050 - s14aK050) > 51 ∧
      2 * (s14bK050 - s14aK050) ≤ 51 ∧ 2 * (s14bK050 - s13nK050) ≤ 51 := by
  decide

/-- r=0.50 峰② 崩塌幅度: 单步位移 53 严格大于净位移 R = 51
    (路径过冲: L1 = 36 已低于 L3 = 38)。 -/
theorem s14_p2_d050_overshoot : s12K050 - s14aK050 > s12K050 - s13nK050 := by
  decide

/-! ### r=0.45: 临界步在最后一步

    路径 47 → 49 → 42 → 20, 步长 2/7/22, R = 27:
    前两个替换几乎不动 (2, 7), 第三个替换 (seed 0→12) 造成 22。 -/

theorem s14_p2_d045_last :
    2 * (s14aK045 - s12K045) ≤ 27 ∧
      2 * (s14aK045 - s14bK045) ≤ 27 ∧ 2 * (s14bK045 - s13nK045) > 27 := by
  decide

/-! ### r=0.35: 前两步均临界

    路径 66 → 47 → 27 → 34, 步长 19/20/7, R = 32: 第一步 2·19 = 38 > 32,
    第二步 2·20 = 40 > 32 (仅第三步 2·7 = 14 ≤ 32 非临界)。r=0.35 是
    双临界剂量 —— 与 r=0.50 (仅首步)、r=0.45 (仅末步) 共同构成临界步
    位置随剂量移动的证据链。 -/

theorem s14_p2_d035 :
    2 * (s12K035 - s14aK035) > 32 ∧ 2 * (s14aK035 - s14bK035) > 32 ∧
      2 * (s14bK035 - s13nK035) ≤ 32 := by decide

/-- **临界步位置随剂量移动** (P2 的核心细化): r=0.50 的崩塌由第一替换
    触发, r=0.45 的崩塌由第三替换触发 —— 不存在"那个临界种子",
    每个剂量点各自对不同种子身份敏感。 -/
theorem s14_dose_dependent :
    2 * (s12K050 - s14aK050) > 51 ∧ 2 * (s14bK045 - s13nK045) > 27 := by
  decide

-- ============================================================
-- §5 P1 否定 (无连续) + P3 否定 (无重组) + 非单调性
-- ============================================================

/-- **P1 否定**: 三个可解读剂量点无一连续 (都存在单步 > R/2)。 -/
theorem s14_p1_rejected :
    ¬(2 * (s12K035 - s14aK035) ≤ 32 ∧ 2 * (s14aK035 - s14bK035) ≤ 32 ∧
        2 * (s14bK035 - s13nK035) ≤ 32) ∧
      ¬(2 * (s14aK045 - s12K045) ≤ 27 ∧ 2 * (s14aK045 - s14bK045) ≤ 27 ∧
        2 * (s14bK045 - s13nK045) ≤ 27) ∧
      ¬(2 * (s12K050 - s14aK050) ≤ 51 ∧ 2 * (s14bK050 - s14aK050) ≤ 51 ∧
        2 * (s14bK050 - s13nK050) ≤ 51) := by decide

/-- **P3 否定**: 三个可解读剂量点的路径长均 ≤ 2R —— 单种子替换是
    "大幅跳变"而非"完全重随机化" (路径有结构, 非纯混沌)。 -/
theorem s14_p3_nowhere :
    (s12K035 - s14aK035) + (s14aK035 - s14bK035) + (s14bK035 - s13nK035) ≤ 2 * 32 ∧
      (s14aK045 - s12K045) + (s14aK045 - s14bK045) + (s14bK045 - s13nK045) ≤ 2 * 27 ∧
      (s12K050 - s14aK050) + (s14bK050 - s14aK050) + (s14bK050 - s13nK050) ≤ 2 * 51 := by
  decide

/-- **r=0.50 路径非单调** (反对 H-a 的第二证据): L2 = 49 反弹, 高于
    L1 = 36 与 L3 = 38 —— 替换路径不是单调滑向终态, 而是逐点重排。 -/
theorem s14_d050_nonmonotone :
    s14aK050 < s13nK050 ∧ s13nK050 < s14bK050 := by decide

-- ============================================================
-- §6 纹理突变: 一步双翻转
-- ============================================================

/-- 峰签名序列 S(L) = (K_035>K_040, K_050>K_045):
    L0 = (1,1), L1 = (1,0), L2 = (0,1), L3 = (0,1)。 -/
theorem s14_signature_seq :
    (s12K035 > s12K040 ∧ s12K050 > s12K045) ∧
      (s14aK035 > s14aK040 ∧ ¬(s14aK050 > s14aK045)) ∧
      (¬(s14bK035 > s14bK040) ∧ s14bK050 > s14bK045) ∧
      (¬(s13nK035 > s13nK040) ∧ s13nK050 > s13nK045) := by decide

/-- **纹理突变**: L1→L2 一步同时翻转两个峰签名分量 ((1,0) → (0,1))
    —— 剂量地形的"纹理" (何处是峰) 在单个种子替换下整体重组。 -/
theorem s14_texture_abrupt :
    (s14aK035 > s14aK040 ∧ ¬(s14bK035 > s14bK040)) ∧
      (¬(s14aK050 > s14aK045) ∧ s14bK050 > s14bK045) := by decide

-- ============================================================
-- §7 探索性对照 (预注册外): 换任意单种子均崩塌
-- ============================================================

/-- **探索性对照 c = {0,1,3}** @ r=0.50 (s14seed_p6.npz): K = 34。
    - 单步位移 55 > R = 51 (与 L1 的 53 同量级);
    - 34 < 38 = L3 全替换水平 —— 换成"近邻"种子 3 与换成 10 崩塌
      程度相同 → 崩塌非种子值特异, 是"单种子身份"的普遍效应;
    - 峰② 针尖 (K=89) 由 {0,1,2} 的具体实现支撑。 -/
theorem s14_control_any_seed :
    2 * (s12K050 - s14cK050) > 51 ∧ s14cK050 < s13nK050 ∧
      s14cK050 - s14aK050 ≤ 2 ∧ s14aK050 - s14cK050 ≤ 2 := by decide

-- ============================================================
-- §8 总裁决
-- ============================================================

/-- **S14 总裁决 (P2 临界单种子 → 多稳态选择)**: E1 确定性成立 ∧
    三个可解读剂量全部出现临界步 ∧ 临界步位置随剂量移动 ∧ 路径非
    单调 ∧ 纹理一步双翻转 ∧ 无重组 —— H-a 累积形变被否定, H-b
    多稳态选择成立 (无单一临界种子, 各剂量各有敏感种子)。 -/
theorem s14_verdict_summary :
    a050cps = a050rcps
      ∧ 2 * (s12K050 - s14aK050) > 51 ∧ 2 * (s14bK045 - s13nK045) > 27
      ∧ 2 * (s14aK035 - s14bK035) > 32
      ∧ s14aK050 < s13nK050 ∧ s13nK050 < s14bK050
      ∧ (s14aK035 > s14aK040 ∧ ¬(s14bK035 > s14bK040))
      ∧ (¬(s14aK050 > s14aK045) ∧ s14bK050 > s14bK045) := by
  refine ⟨rfl, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- 峰② 针尖的支撑条件: K=89 仅在 {0,1,2} 实现下成立; 三个单种子替换
    变体 (L1, c, 及 L2 的两步替换) 全部 ≤ 49 = 89 − 40, 即掉落
    ≥ 40/480 (L2 恰取等: 49 = 89 − 40)。 -/
theorem s14_peak2_needle_support :
    s14aK050 ≤ s12K050 - 40 ∧ s14bK050 ≤ s12K050 - 40 ∧
      s14cK050 ≤ s12K050 - 40 := by decide

-- ============================================================
-- §9 溯源哈希 (s14_export.json sha256, 2026-08-31)
-- ============================================================

/-- 数据溯源: 全部 7 个 S14 数据文件 SHA256 (64 hex)。 -/
def shaS14P1 : String := "af71aa76986ed6f46bf1713baff850d0aa24b7367e06a326ea1e0a40ea9e6061"
def shaS14P2 : String := "09cb870b1be96485e196b49356a37b1dd4cb0873bdf1bb18b16b45fdc613fc07"
def shaS14P3 : String := "6815a94065a5ccff468dd59b4d511f5379d10dcfa867ebfe6d3aa6617350aa00"
def shaS14P4 : String := "4774b5e477f76dc84cd9782a1355efcd41c2fd55a0f68647b93c0f759464e2cb"
def shaS14P5 : String := "d8bc7b72718d48bfe8212aa10d301294327e6452624108319f3bb216bfcdf7a0"
def shaS14P6 : String := "4a3fc44ce3e52bd2994244e5fd9844adcbd8460b74eb79b5dc7f108a6aff400c"
def shaS14Syn : String := "1054307564c639eb618a151ab81f020ff37b6f82d60acf9e8b3fb5f1ca2f03d0"

/-- 哈希登记完整性: 7 个哈希均为 64 位 hex 且互不相同
    (s14_export.json §sha256 与本模块逐字符一致)。 -/
theorem s14_sha_registered :
    shaS14P1.length = 64 ∧ shaS14P2.length = 64 ∧ shaS14P3.length = 64
      ∧ shaS14P4.length = 64 ∧ shaS14P5.length = 64 ∧ shaS14P6.length = 64
      ∧ shaS14Syn.length = 64
      ∧ shaS14P1 ≠ shaS14P2 ∧ shaS14P2 ≠ shaS14P3 ∧ shaS14P3 ≠ shaS14P4
      ∧ shaS14P4 ≠ shaS14P5 ∧ shaS14P5 ≠ shaS14P6 ∧ shaS14P6 ≠ shaS14Syn := by
  decide

end CDD.W4.SeedPath
